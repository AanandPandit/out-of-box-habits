/* Global Reset */
QWidget {
    background-color: #000000;
    color: #00FF00;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 16px; /* Increased font size */
    selection-background-color: #00FF00;
    selection-color: #000000;
}

/* Menu Bar */
QMenuBar {
    background-color: #000000;
    border-bottom: 1px solid #00FF00;
    font-family: "h Hackout", "Consolas", monospace; /* Menu font */
}
QMenuBar::item {
    spacing: 10px;
    padding: 8px 15px;
    background: transparent;
    color: #00FF00;
}
QMenuBar::item:selected {
    background: #00FF00;
    color: #000000;
}

/* Scrollbars */
QScrollBar:vertical {
    border: 1px solid #003300;
    background: #000000;
    width: 12px;
}
QScrollBar::handle:vertical {
    background: #00FF00;
    min-height: 20px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* Buttons */
QPushButton {
    border: 1px solid #00FF00;
    background-color: #000000;
    color: #00FF00;
    padding: 8px 15px;
    text-transform: uppercase;
    font-weight: bold;
}
QPushButton:hover {
    background-color: #003300;
    border: 1px solid #00FFFF;
    color: #00FFFF;
}
QPushButton:pressed {
    background-color: #00FF00;
    color: #000000;
}

/* Line Edits & Text Areas */
QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #050505;
    border: 1px solid #003300;
    color: #00FF00;
    padding: 8px;
}
QLineEdit:focus, QTextEdit:focus {
    border: 1px solid #00FF00;
}

/* Lists & Trees */
QListWidget, QTreeWidget {
    border: 1px solid #003300;
    background-color: #000000;
}
QListWidget::item:selected, QTreeWidget::item:selected {
    background-color: #003300;
    color: #00FFFF;
    border: 1px solid #00FF00;
}

/* Labels */
QLabel {
    color: #00FF00;
}
QLabel#Header {
    font-size: 28px;
    font-weight: bold;
    color: #00FFFF;
    border-bottom: 2px solid #00FF00;
    padding-bottom: 10px;
}

/* Custom Classes */
.Card {
    border: 1px solid #003300;
    background-color: #020202;
    padding: 15px;
}
.Card:hover {
    border: 1px solid #00FF00;
}

/* Chatbot Specific */
.ChatBubbleUser {
    color: #00FFFF;
}
.ChatBubbleAI {
    color: #00FFFF;
}

/* Markdown Styles in QTextEdit */
code {
    background-color: #111;
    color: #FF00FF; /* Magenta for code to stand out */
    font-family: "Consolas", monospace;
    padding: 2px;
}
pre {
    background-color: #111;
    color: #00FF00;
    border: 1px solid #003300;
    padding: 5px;
    margin: 5px 0;
}
strong {
    color: #FFFF00; /* Yellow for bold */
    font-weight: bold;
}
em {
    color: #00FFFF; /* Cyan for italic */
    font-style: italic;
}
h1, h2, h3, h4 {
    color: #00FF00;
    font-weight: bold;
    margin-top: 10px;
    border-bottom: 1px solid #003300;
}
ul, ol {
    margin-left: 20px;
}
li {
    color: #EEEEEE;
}
a {
    color: #00FFFF;
    text-decoration: underline;
}

/* Section Colors */
.SectionProtocols { border-left: 3px solid #00FF00; }
.SectionMain { border-left: 3px solid #00FFFF; }
.SectionOutreach { border-left: 3px solid #FF0033; }
